{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "base_sha",
    "diff_hash",
    "summary",
    "issues",
    "blocking_count",
    "scope_assessment",
    "test_assessment",
    "confidence",
    "requires_human",
    "partial_context"
  ],
  "properties": {
    "verdict": {
      "enum": ["approve", "request_changes", "already_fixed", "cannot_review"]
    },
    "base_sha": {
      "type": "string",
      "description": "Echo of the base commit you were given, unchanged."
    },
    "diff_hash": {
      "type": "string",
      "description": "Echo of the diff hash you were given, unchanged."
    },
    "summary": {
      "type": "string",
      "maxLength": 2000,
      "description": "Two or three sentences a human can read in the PR body."
    },
    "blocking_count": {
      "type": "integer",
      "minimum": 0,
      "description": "How many findings are at or above the blocking severity."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_human": {
      "type": "boolean",
      "description": "True if the decision needs context you do not have."
    },
    "partial_context": {
      "type": "boolean",
      "description": "True if the diff was truncated or you could not read something you needed."
    },
    "issues": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "category", "file", "line", "title", "detail", "suggestion"],
        "properties": {
          "id": { "type": "string", "description": "Short stable id, e.g. C1." },
          "severity": { "enum": ["blocker", "major", "minor", "nit"] },
          "category": {
            "enum": ["correctness", "security", "tests", "performance", "style", "scope", "docs"]
          },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "maxLength": 200 },
          "detail": { "type": "string", "maxLength": 4000 },
          "suggestion": { "type": "string", "maxLength": 4000 }
        }
      }
    },
    "scope_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matches_issue", "unrelated_changes", "behavior_changes_undocumented"],
      "properties": {
        "matches_issue": { "type": "boolean" },
        "unrelated_changes": { "type": "array", "items": { "type": "string" } },
        "behavior_changes_undocumented": { "type": "boolean" }
      }
    },
    "test_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests_present", "tests_weakened", "missing_coverage", "notes"],
      "properties": {
        "tests_present": { "type": "boolean" },
        "tests_weakened": {
          "type": "boolean",
          "description": "True if the diff deletes or weakens existing tests."
        },
        "missing_coverage": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    }
  }
}
